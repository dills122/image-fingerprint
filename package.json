{
  "name": "image-fingerprint",
  "version": "0.1.1-rc.0",
  "description": "Deterministic, versioned image fingerprints for Node.js and browsers",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./node": {
      "types": "./lib/node.d.ts",
      "require": "./lib/node.js",
      "default": "./lib/node.js"
    },
    "./browser": {
      "types": "./lib/browser.d.ts",
      "import": "./lib/esm/browser.mjs",
      "require": "./lib/browser.js",
      "default": "./lib/esm/browser.mjs"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/esm/core.mjs",
      "require": "./lib/core/index.js",
      "default": "./lib/esm/core.mjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "codex:links": "./scripts/setup-codex-links.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pdq:oracle:build": "./scripts/build-pdq-oracle.sh",
    "pdq:wasm:build": "./scripts/build-pdq-wasm-oracle.sh",
    "pdq:oracle:smoke": "node scripts/pdq-oracle-smoke.mjs",
    "pdq:fixtures:generate": "node scripts/generate-pdq-fixtures.mjs",
    "pdq:stages:generate": "node scripts/generate-pdq-stage-fixtures.mjs",
    "pdq:dct-matrix:generate": "node scripts/generate-pdq-dct-matrix.mjs",
    "pdq:wasm:compare": "node scripts/compare-pdq-wasm-oracle.mjs",
    "pdq:differential": "pnpm build && node scripts/pdq-differential.mjs",
    "pdq:adapter:fixtures:generate": "node benchmarks/pdq/generate-adapter-fixtures.mjs",
    "pdq:adapter:differential": "pnpm build && node benchmarks/pdq/adapter-differential.mjs",
    "pdq:performance:wasm:build": "./scripts/build-pdq-performance-wasm.sh",
    "pdq:performance:node": "pnpm build && node benchmarks/pdq/core-performance.mjs --node",
    "pdq:performance:browser": "pnpm build && node benchmarks/pdq/browser-performance.mjs --run",
    "pdq:matching:prepare": "node benchmarks/pdq/prepare-solring-corpus.mjs",
    "pdq:matching": "pnpm build && node benchmarks/pdq/matching-quality.mjs",
    "compat:image-hash-v7": "pnpm build && node scripts/image-hash-v7-differential.mjs",
    "crop-block:experiment": "pnpm build && node benchmarks/crop-block/experiment.mjs",
    "crop-block:browser": "pnpm build && node benchmarks/crop-block/browser-exactness.mjs",
    "crop-block:met:prepare": "node benchmarks/crop-block/prepare-met-corpus.mjs",
    "crop-block:met": "pnpm build && node benchmarks/crop-block/met-quality.mjs",
    "crop-block:mixed:prepare": "node benchmarks/crop-block/prepare-mixed-corpus.mjs",
    "crop-block:mixed": "pnpm build && node benchmarks/crop-block/mixed-quality.mjs",
    "crop-block:v2:develop": "pnpm build && node benchmarks/crop-block/v2-development.mjs",
    "crop-keypoint:develop": "pnpm build && node benchmarks/crop-keypoint/development.mjs",
    "crop-local:oracle": "uv run --script benchmarks/crop-local/oracle.py",
    "crop-local:typescript:develop": "pnpm build && node benchmarks/crop-local/typescript-development.mjs",
    "crop-local:browser": "pnpm build && node benchmarks/crop-local/browser-exactness.mjs",
    "crop-local:retrieval:develop": "pnpm build && node benchmarks/crop-local/retrieval-development.mjs",
    "test:package": "pnpm build && node scripts/package-smoke.cjs && node scripts/browser-package-smoke.mjs && node scripts/packed-package-smoke.mjs",
    "test:browser": "node scripts/browser-engine-smoke.mjs",
    "test:watch": "vitest",
    "build": "pnpm clean && tsc && vite build --config vite.lib.config.mts",
    "clean": "node scripts/clean.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"__tests__/**/*.ts\" \"*.config.{ts,mts}\"",
    "lint:fix": "pnpm lint --fix",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:package",
    "pack:check": "pnpm build && node scripts/verify-pack.cjs",
    "prepack": "pnpm build",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site build",
    "site:preview": "pnpm --dir site preview"
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dills122/image-fingerprint.git"
  },
  "keywords": [
    "image fingerprint",
    "image matching",
    "perceptual hashing",
    "pdq",
    "blockhash",
    "hash",
    "image hash",
    "perceptual hash",
    "browser",
    "node.js"
  ],
  "author": "Dylan Steele",
  "contributors": [
    "Daniel Morrison <daniel.morrison@bbc.co.uk>",
    "image-hash contributors"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dills122/image-fingerprint/issues"
  },
  "homepage": "https://dills122.github.io/image-fingerprint/",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@cwasm/webp": "0.1.5",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "@types/pngjs": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
