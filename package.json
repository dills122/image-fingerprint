{
  "name": "image-fingerprint",
  "version": "0.1.0",
  "description": "Create deterministic, cross-platform image fingerprints",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./node": {
      "types": "./lib/node.d.ts",
      "require": "./lib/node.js",
      "default": "./lib/node.js"
    },
    "./browser": {
      "types": "./lib/browser.d.ts",
      "import": "./lib/esm/browser.mjs",
      "require": "./lib/browser.js",
      "default": "./lib/esm/browser.mjs"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/esm/core.mjs",
      "require": "./lib/core/index.js",
      "default": "./lib/esm/core.mjs"
    },
    "./lib": "./lib/index.js",
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "codex:links": "./scripts/setup-codex-links.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:network": "cross-env RUN_NETWORK_TESTS=1 vitest run",
    "pdq:oracle:build": "./scripts/build-pdq-oracle.sh",
    "pdq:wasm:build": "./scripts/build-pdq-wasm-oracle.sh",
    "pdq:oracle:smoke": "node scripts/pdq-oracle-smoke.mjs",
    "pdq:fixtures:generate": "node scripts/generate-pdq-fixtures.mjs",
    "pdq:stages:generate": "node scripts/generate-pdq-stage-fixtures.mjs",
    "pdq:dct-matrix:generate": "node scripts/generate-pdq-dct-matrix.mjs",
    "pdq:wasm:compare": "node scripts/compare-pdq-wasm-oracle.mjs",
    "pdq:differential": "pnpm build && node scripts/pdq-differential.mjs",
    "pdq:adapter:fixtures:generate": "node benchmarks/pdq/generate-adapter-fixtures.mjs",
    "pdq:adapter:differential": "pnpm build && node benchmarks/pdq/adapter-differential.mjs",
    "pdq:performance:wasm:build": "./scripts/build-pdq-performance-wasm.sh",
    "pdq:performance:node": "pnpm build && node benchmarks/pdq/core-performance.mjs --node",
    "pdq:performance:browser": "pnpm build && node benchmarks/pdq/browser-performance.mjs --run",
    "test:package": "pnpm build && node scripts/package-smoke.cjs && node scripts/browser-package-smoke.mjs && node scripts/packed-package-smoke.mjs",
    "test:browser": "node scripts/browser-engine-smoke.mjs",
    "test:watch": "vitest",
    "build": "pnpm clean && tsc && vite build --config vite.lib.config.mts",
    "clean": "node scripts/clean.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"__tests__/**/*.ts\" \"*.config.{ts,mts}\"",
    "lint:fix": "pnpm lint --fix",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:package",
    "pack:check": "pnpm build && node scripts/verify-pack.cjs",
    "prepack": "pnpm build"
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dills122/image-hash.git"
  },
  "keywords": [
    "phash",
    "hash",
    "image hash",
    "perceptual hash"
  ],
  "author": "Dylan Steele",
  "contributors": [
    "Daniel Morrison <daniel.morrison@bbc.co.uk>",
    "image-hash contributors"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dills122/image-hash/issues"
  },
  "homepage": "https://github.com/dills122/image-hash#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@cwasm/webp": "^0.1.5",
    "file-type": "^21.3.2",
    "jpeg-js": "^0.4.0",
    "pngjs": "^7.0.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "@types/pngjs": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
