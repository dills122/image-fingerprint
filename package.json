{
  "name": "image-hash",
  "version": "7.0.1",
  "description": "Create a hash from an image",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "codex:links": "./scripts/setup-codex-links.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:network": "cross-env RUN_NETWORK_TESTS=1 vitest run",
    "test:package": "pnpm build && node scripts/package-smoke.cjs",
    "test:watch": "vitest",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"__tests__/**/*.ts\" \"*.config.{ts,mts}\"",
    "lint:fix": "pnpm lint --fix",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:package",
    "prepack": "pnpm build"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danm/image-hash.git"
  },
  "keywords": [
    "phash",
    "hash",
    "image hash",
    "perceptual hash"
  ],
  "author": "Daniel Morrison <daniel.morrison@bbc.co.uk>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danm/image-hash/issues"
  },
  "homepage": "https://github.com/danm/image-hash#readme",
  "dependencies": {
    "@cwasm/webp": "^0.1.5",
    "file-type": "^21.0.0",
    "jpeg-js": "^0.4.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "@types/pngjs": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
